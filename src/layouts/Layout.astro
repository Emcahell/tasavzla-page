---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TasaVzla — La tasa oficial del BCV, siempre a un toque',
  description = 'Consulta el dólar y el euro a bolívares al instante con la tasa oficial del BCV. Convierte montos y comparte el resultado con un solo toque.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="bg-animated" aria-hidden="true">
      <div class="glow-wine"></div>
      <div class="overlay"></div>
    </div>
    <slot />
  </body>
</html>
